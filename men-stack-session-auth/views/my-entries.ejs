<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>My Entries</h1>
    <% for(let entry of entries) { %>
        <div>
            <h2><%= entry.title %></h2>
            <p><%= entry.entry %></p>
            <p>By: <%= entry.owner.username %></p>
      
        </div>
    <% } %>